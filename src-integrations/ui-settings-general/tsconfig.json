{
  // 覆盖层是「盖进上游包里」才成立的：相对 import（./locales.ts 等）指向上游文件，
  // 上游包（@deepseek-ai/dsh-client-*）也只住在依赖/镜像里。这份 tsconfig 只服务编辑器：
  //   · rootDirs 把覆盖目录与上游镜像的 src 视作同一个根，相对 import 便能找到邻位；
  //   · tsconfig.paths.json（node scripts/ide-tsconfig.mts 生成）给出 @deepseek-ai/* → 镜像源映射。
  // 判定口径仍以 scripts/overlay-typecheck.mts 为准（它在暂存树里跑）；这里只服务编辑器。
  "extends": ["../../tsconfig.json", "../tsconfig.paths.json"],
  "compilerOptions": {
    "rootDirs": [
      "files/src",
      "../../vendor/deepseek-harness/packages/client/ui-settings-general/src"
    ]
  },
  "include": [
    "files/src/**/*.ts",
    "files/src/**/*.tsx",
    "../../vendor/deepseek-harness/packages/client/ui-settings-general/src/**/*.ts",
    "../../vendor/deepseek-harness/packages/client/ui-settings-general/src/**/*.tsx"
  ],
  // 排除上游里被本覆盖层替换掉的文件：覆盖版与上游版并存会让同名声明打架
  // （locale 键集这类靠模块增强聚合的类型尤其明显）。暂存树里同名文件已被覆盖，不存在这一对。
  "exclude": [
    "../../vendor/deepseek-harness/packages/client/ui-settings-general/src/client/SettingsRoot.tsx",
    "../../vendor/deepseek-harness/packages/client/ui-settings-general/src/client/locales.ts"
  ]
}
