{
  // 覆盖层是「盖进上游包里」才成立的：相对 import（./contract/slots.ts 等）指向上游文件，
  // 上游包（@deepseek-ai/dsh-client-*）也只住在依赖/镜像里。这份 tsconfig 只服务编辑器：
  //   · rootDirs 把覆盖目录与上游镜像的 src 视作同一个根，相对 import 便能找到邻位；
  //   · tsconfig.paths.json（node scripts/ide-tsconfig.mts 生成）给出 @deepseek-ai/* → 镜像源映射。
  //
  // 判定口径仍以 scripts/overlay-typecheck.mts 为准（它在暂存树里跑，才是拦不拦的依据）；
  // 这里只服务编辑器体验，不参与 typecheck / build。
  "extends": ["../../tsconfig.json", "../tsconfig.paths.json"],
  "compilerOptions": {
    "rootDirs": [
      "files/src",
      "../../vendor/deepseek-harness/packages/client/ui-sidebar/src"
    ]
  },
  "include": [
    "files/src/**/*.ts",
    "files/src/**/*.tsx",
    // 上游整包源都纳入：不只是被 import 的那些。模块增强（locale 命名空间声明在
    // locales.ts 里）与全局声明（css-modules.d.ts）要“在程序里”才生效，只 include 自己的
    // 文件会让 PropsLocale<'sidebar'> 这类依赖增强的类型丢域。
    "../../vendor/deepseek-harness/packages/client/ui-sidebar/src/**/*.ts",
    "../../vendor/deepseek-harness/packages/client/ui-sidebar/src/**/*.tsx"
  ]
}
