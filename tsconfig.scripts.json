{
  // scripts 域（构建与工具脚本）的类型检查配置。
  // 为什么在这里：这些脚本由 node 直接跑（原生类型剥离只去类型、不做检查），这份配置让
  // scripts/typecheck.mts 把"自相矛盾"那一类（未定义的名字、不存在的成员、参数个数不符、
  // 语法错）拦在构建期。口径与失败清单见 scripts/ts-diagnostics.mts。
  // 路径相对本文件（仓库根）解析，所以不写绝对路径。
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // 脚本跑在 node 里，没有 DOM。
    "lib": ["ES2022"],
    "types": ["node"],
    // 本仓的直接依赖住在 pnpm 的隐藏目录：不指这里的话，terser/archiver 那批包解析不到，
    // 报错会落在"包没装"而不是我们的代码上。
    "paths": { "*": ["./node_modules/.pnpm/node_modules/*"] },
    "typeRoots": ["./node_modules/.pnpm/node_modules/@types"],
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    // 相对 import 显式写 .mts（Node ESM 可直跑、bundler 能解）。
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*.mts"]
  // 非失败类诊断只看计数不阻断；看明细：
  //   node node_modules/typescript/bin/tsc -p tsconfig.scripts.json --pretty false
}
