<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>DSHana 通道</title>
<style>
  html, body { margin: 0; padding: 0; height: 100%; background: transparent; }
  body { display: flex; align-items: center; justify-content: center; font: 13px/1.6 system-ui, sans-serif; color: var(--text-muted, #888); }
  .tip { text-align: center; }
</style>
</head>
<body>
<div class="tip">DSHana 通道引导中…</div>
<script>
(function () {
  // /web 通道引导页（v8）：注册 SW（scope = 本页的 /web/ 子路径）接管 /web/ 下的
  // 全部请求，经 HTTP 隧道转发 dsh。页面自身由宿主 /web 端点 serve（功能路由，
  // 非静态资源服务）。注册成功 → postMessage bridge-config → 跳 /web/（SW 接管
  // 导航）；失败/超时 → 直连 http://127.0.0.1:<port>/（本地体验不退化）。
  var api = {{= JSON.stringify(it.api) }};
  var port = {{= it.port }};
  var params = new URLSearchParams(location.search);
  var token = params.get("token") || "";
  var surfaceSession = params.get("pluginSurfaceSession") || "";
  var swUrl = api + "/sw.js" + (token ? "?token=" + encodeURIComponent(token) : "");
  var scope = api + "/web/";
  function goDirect() {
    location.replace("http://127.0.0.1:" + port + "/?dshReload=" + Date.now());
  }
  function setup() {
    if (!("serviceWorker" in navigator)) { goDirect(); return; }
    var chain = navigator.serviceWorker.register(swUrl, { scope: scope })
      .then(function () { return navigator.serviceWorker.ready; })
      .then(function (reg) {
        if (reg && reg.active) {
          reg.active.postMessage({
            type: "bridge-config",
            mode: "http-tunnel",
            tunnelUrl: location.origin + api + "/bridge/http",
            surfaceSession: surfaceSession,
          });
        }
        // SW 接管：/web/ 导航经隧道转发 dsh（index.html 由 SW 改写绝对路径）
        location.replace(scope + "?dshReload=" + Date.now());
      });
    // 超时兜底：SW 首次注册（下载+编译+激活）可能较慢，20s 仍未就绪视为挂起，
    // 直连保界面；隧道链路留待下次刷新重试。
    var timer = setTimeout(function () {
      console.warn("[dsh-hanako] 通道引导超时（20s），直连");
      goDirect();
    }, 20000);
    chain.catch(function (err) {
      clearTimeout(timer);
      console.warn("[dsh-hanako] SW 注册失败，直连:", err);
      goDirect();
    });
  }
  setup();
})();
</script>
</body>
</html>
