    // 流在 ready 前断开（网络/服务端关闭）时按 10s 退避重开（有界 10 次）——
    // 覆盖「web host 启动失败后用户修复重新拉起」的 ready 到达窗口
    var streamRetries = 0;
    function openReadyStream() {
      if (readyReceived || streamRetries >= 10) return;
      var ac = new AbortController();
      streamAbort = ac;
