              buf += decoder.decode(value, { stream: true });
              var idx;
              while ((idx = buf.indexOf("\n\n")) !== -1) {
                var chunk = buf.slice(0, idx);
                buf = buf.slice(idx + 2);
                var dataLine = null;
                var ls = chunk.split("\n");
                for (var i = 0; i < ls.length; i++) {
                  if (ls[i].indexOf("data: ") === 0) { dataLine = ls[i].slice(6); break; }
