{
  "manifestVersion": 2,
  "id": "dsh-hanako",
  "name": "DSHana",
  "version": "1.0.0-beta.3+dsh-0.1.2-rc.1",
  "description": "DSHana: DeepSeek Harness as a subagent for HanaAgent",
  "author": "Nyaser",
  "minAppVersion": "0.810.0",
  "trust": "full-access",
  "ui": {
    "hostCapabilities": [
      "clipboard.writeText"
    ]
  },
  "capabilities": [
    "resource.watch",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "127.0.0.1",
      "localhost"
    ],
    "methods": [
      "POST"
    ],
    "defaultTimeoutMs": 5000,
    "maxResponseBytes": 1024
  },
  "activationEvents": [
    "onStartup"
  ],
  "entry": "index.js",
  "contributes": {
    "configuration": {
      "title": "DSHana 设置",
      "properties": {
        "webPort": {
          "type": "number",
          "default": 3080,
          "title": "DSH WebUI 端口"
        },
        "approvalTimeoutSec": {
          "type": "number",
          "default": 30,
          "title": "审批超时",
          "description": "审批超时自动拒绝（单位：秒）"
        },
        "defaultTimeoutSec": {
          "type": "number",
          "default": 1800,
          "title": "任务超时",
          "description": "单次任务默认超时（单位：秒）"
        },
        "nodejsPath": {
          "type": "string",
          "default": "",
          "title": "自定义 NodeJS 路径",
          "description": "可选，留空使用 hana-server 作为 Node 运行时，修改后需重启"
        }
      }
    },
    "cards": [
      {
        "id": "dshana",
        "title": "DSHana",
        "route": "/webui",
        "cardForm": "flush",
        "titlebar": "translucent",
        "realization": "page",
        "siteNavEntry": true,
        "fpFullPanel": true,
        "functionPanel": {
          "id": "dshana-panel",
          "label": "DSHana"
        }
      }
    ]
  }
}