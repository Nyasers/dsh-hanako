{
  "manifestVersion": 2,
  "id": "dsh-hanako",
  "name": "DSHana",
  "version": "1.0.0-beta.5+dsh-0.1.2-rc.1",
  "description": "DSHana: DeepSeek Harness as a subagent for HanaAgent",
  "author": "Nyaser",
  "icon": "icon.png",
  "minAppVersion": "0.930.1",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/tasks.manage",
    "app/session.start-turn",
    "app/models.infer",
    "app/runtime.execute",
    "app/runtime.native",
    "app/runtime.network"
  ],
  "network": {
    "allowedHosts": [
      "127.0.0.1",
      "localhost"
    ],
    "methods": [
      "POST"
    ],
    "defaultTimeoutMs": 5000,
    "maxResponseBytes": 1024
  },
  "entry": "index.js",
  "contributes": {
    "settings": {
      "title": "DSHana 设置",
      "schema": {
        "type": "object",
        "properties": {
          "approvalTimeoutSec": {
            "type": "number",
            "default": 30,
            "title": "审批超时",
            "description": "审批超时自动拒绝（单位：秒）"
          },
          "defaultTimeoutSec": {
            "type": "number",
            "default": 1800,
            "title": "任务超时",
            "description": "单次任务默认超时（单位：秒）"
          },
          "nodejsPath": {
            "type": "string",
            "default": "",
            "title": "自定义 NodeJS 路径",
            "description": "可选，留空使用 hana-server 作为 Node 运行时，修改后需重启"
          },
          "servicePort": {
            "type": "integer",
            "default": 4317,
            "title": "本地服务端口",
            "description": "受管 DSH 服务监听端口（1024~65535；被占用时自动向后重选，最多 5 次）"
          }
        }
      }
    },
    "cards": [
      {
        "id": "dshana",
        "title": "DSHana",
        "route": "/main",
        "cardForm": "flush",
        "titlebar": "translucent",
        "realization": "page",
        "siteNavEntry": true
      },
      {
        "id": "dshana-sidebar",
        "title": "DSHana Sidebar",
        "route": "/sidebar",
        "cardForm": "flush",
        "pageOf": "dshana"
      }
    ]
  }
}
