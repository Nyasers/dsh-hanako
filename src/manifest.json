{
  "manifestVersion": 2,
  "id": "dsh-hanako",
  "name": "DSHana",
  "version": "1.0.0-beta.5+dsh-0.1.2-rc.1",
  "description": "DSHana：把 DeepSeek Harness 作为 HanaAgent 的子代理运行",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "minAppVersion": "0.951.4",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/tasks.manage",
    "app/session.start-turn",
    "app/models.infer",
    "app/resources.read",
    "app/runtime.execute",
    "app/runtime.local-machine",
    "app/runtime.network",
    "app/ui.clipboard-write"
  ],
  "network": {
    "allowedHosts": [
      "127.0.0.1"
    ],
    "methods": [
      "GET",
      "POST"
    ],
    "allowLocalhost": true,
    "defaultTimeoutMs": 60000,
    "maxResponseBytes": 8388608
  },
  "contributes": {
    "cards": [
      {
        "id": "dshana",
        "title": "DSHana",
        "description": "DSHana bootstrap and workspace",
        "route": "/main.html",
        "realization": "page",
        "functionPanel": {
          "id": "sidebar",
          "label": "DSHana",
          "route": "/sidebar.html"
        },
        "siteNavEntry": true,
        "fpFullPanel": true,
        "closable": false,
        "cardForm": "flush",
        "titlebar": "translucent"
      }
    ],
    "settings": {
      "title": "DSHana",
      "schema": {
        "properties": {
          "approvalTimeoutSec": {
            "type": "number",
            "default": 30,
            "title": "审批超时（秒）",
            "description": "审批超时自动拒绝（单位：秒）；显式设 0 禁用自动拒绝"
          },
          "defaultTimeoutSec": {
            "type": "number",
            "default": 1800,
            "title": "任务默认超时（秒）",
            "description": "单次任务默认超时（单位：秒）；0 或缺失回落 600 秒"
          }
        }
      }
    }
  }
}