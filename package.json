    "build:src": "node src/build.js",
    "build:cordis": "node src-cordis/build.js",
    "syncver": "node scripts/syncver.mjs",
    "changelog": "node scripts/changelog.mjs",
    "prepack": "pnpm run syncver && pnpm run build",
    "pack": "node scripts/pack.mjs",
    "postpack": "node scripts/clean-tmp.mjs",
    "pack:linux-x64": "pnpm run pack --target=linux-x64",
    "pack:darwin-arm64": "pnpm run pack --target=darwin-arm64",
    "pack:darwin-x64": "pnpm run pack --target=darwin-x64",
    "pack:win32-x64": "pnpm run pack --target=win32-x64",
    "pack:universal": "pnpm run pack --target=universal",
    "pack:linux-arm64": "pnpm run pack --target=linux-arm64",
    "pack:win32-arm64": "pnpm run pack --target=win32-arm64",
    "preversion": "pnpm run build",
    "version": "node scripts/version-hook.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.2"
  },
  "devDependencies": {
