    "@rspack/core": "^2.2.2",
    "archiver": "^8.0.0",
    "clean-css": "^5.3.3",
    "clsx": "^2.1.1",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "corepack": "0.36.0",
    "fs-extra": "^11.4.0",
    "terser": "^5.51.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
