{
  "name": "dshana",
  "version": "1.0.0-beta.5+dsh-0.1.5-rc.2",
  "private": true,
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "pnpm run verify:integrations && pnpm run typecheck && pnpm run build:src && pnpm run build:cordis && pnpm run build:integrations",
    "build:src": "node src/build.ts",
    "build:cordis": "node src-cordis/build.ts",
    "build:integrations": "node scripts/integrations.mts build",
    "verify:integrations": "node scripts/integrations.mts verify",
    "typecheck": "node scripts/typecheck.mts",
    "test": "node --test tests/",
    "syncver": "node scripts/syncver.mts",
    "changelog": "node scripts/changelog.mts",
    "prepackage": "pnpm run syncver && pnpm run build",
    "package": "node scripts/pack.mts",
    "postpackage": "node scripts/clean-tmp.mts",
    "package:linux:x64": "pnpm run package --target=linux-x64",
    "package:linux:arm64": "pnpm run package --target=linux-arm64",
    "package:mac:x64": "pnpm run package --target=darwin-x64",
    "package:mac:arm64": "pnpm run package --target=darwin-arm64",
    "package:win:x64": "pnpm run package --target=win32-x64",
    "package:win:arm64": "pnpm run package --target=win32-arm64",
    "package:universal": "pnpm run package --target=universal",
    "preversion": "pnpm run build",
    "version": "node scripts/version-hook.mts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-open-in-app": "0.1.5-rc.2",
    "@hana/app-sdk": "file:vendor/hana-app-sdk/hana-app-sdk.tgz",
    "@hana/plugin-components": "file:vendor/hana-app-sdk/hana-plugin-components-0.0.0.tgz",
    "@hana/plugin-protocol": "file:vendor/hana-app-sdk/hana-plugin-protocol-0.0.0.tgz",
    "@hana/plugin-sdk": "file:vendor/hana-app-sdk/hana-plugin-sdk-0.0.0.tgz",
    "@rspack/core": "^2.2.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "archiver": "^8.0.0",
    "clean-css": "^5.3.3",
    "clsx": "^2.1.1",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "corepack": "0.36.0",
    "fs-extra": "^11.4.0",
    "html-minifier-terser": "^7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "terser": "^5.51.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
